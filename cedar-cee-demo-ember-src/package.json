{
  "name": "cedar-cee-demo-ember-src",
  "version": "2.9.38-SNAPSHOT",
  "private": true,
  "description": "Small description for cedar-cee-demo-ember-src goes here",
  "repository": "",
  "license": "BSD-2-Clause",
  "author": "",
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && npm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "vite",
    "test": "vite build --mode development && ember test --path dist",
    "test:ember": "vite build --mode development && ember test --path dist"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.4.3",
    "@embroider/compat": "^4.1.29",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.3",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.20.6",
    "@embroider/vite": "^1.8.1",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@rollup/plugin-babel": "^7.1.0",
    "babel-plugin-ember-template-compilation": "^4.0.2",
    "concurrently": "^10.0.7",
    "decorator-transforms": "^2.4.0",
    "ember-cli": "~7.4.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.1.0",
    "ember-qunit": "^9.2.1",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.4.1",
    "ember-template-lint": "^7.9.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.11.5",
    "eslint-plugin-n": "^18.6.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-ember-template-tag": "^2.1.7",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "vite": "^8.3.8"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "tmp": "^0.2.7",
    "minimatch@>=7 <11.0.1": "11.0.5",
    "glob@>=9 <14.0.2": "14.0.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "ember": {
    "edition": "octane"
  },
  "dependencies": {
    "cedar-embeddable-editor": "npm:@org.metadatacenter/cedar-embeddable-editor@2.0.38-dev.20261127.683ee26"
  }
}
