/* To learn more about this file see: https://angular.dev/reference/configs/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // The specs read the two JSON assets the running app fetches, so the editor is
    // tested against the configuration and template the demo ships. The application
    // itself imports no JSON, so these stay out of its own compilation.
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"]
}
